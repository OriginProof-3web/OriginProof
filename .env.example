# Copy to .env. Never commit real credentials or private keys.
APP_ENV=development
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_DATABASE_URL=postgresql+asyncpg://originproof:originproof@postgres:5432/originproof
# Network switch: anvil (default, local 31337) or sepolia (11155111). It sets the chain ID,
# so leave API_BLOCKCHAIN_CHAIN_ID unset; a conflicting value is rejected at startup.
CHAIN_TARGET=anvil
API_BLOCKCHAIN_RPC_URL=http://anvil:8545
# Dual-RPC slot. For sepolia both must be https; provider keys belong only in your local .env.
API_BLOCKCHAIN_RPC_FALLBACK_URL=
# Optional override; default is packages/contracts/deployments/<chainId>.wallet[.local].json.
API_WALLET_MANIFEST_PATH=
API_BLOCKCHAIN_MANIFEST_PATH=/workspace/packages/contracts/deployments/31337.local.json
API_BLOCKCHAIN_ISSUER_ID=iss_origin_mock_bank
# Wallet Registry deploy wrapper (packages/contracts/script/deploy_wallet_registry.py).
# Public approver addresses only; signing uses --account/--ledger/--trezor, never a key here.
WALLET_APPROVER_1_ADDRESS=
WALLET_APPROVER_2_ADDRESS=
WALLET_APPROVER_3_ADDRESS=
REDIS_URL=redis://redis:6379/0
ANALYZER_BASE_URL=http://analyzer:8001
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
LLM_PROVIDER=mock
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# OPENAI_API_KEY is optional and belongs only in a local .env file.

# Synthetic issuer signing files: private directory inside the persistent API volume.
API_FINALS_PAYMENT_ISSUER_ID=iss_finals_mock_bank
API_FINALS_DOCUMENT_ISSUER_ID=iss_finals_mock_office
API_SIGNER_DIRECTORY=build/secrets/issuer-signers
# Set a private random value of at least 32 bytes before enabling demo wallet email.
# API_WALLET_EMAIL_SECRET=
API_PROJECTION_ENABLED=true
API_PROJECTION_POLL_SECONDS=5
# P0 API runs with one worker; JSON lists are required for browser origins.
API_BROWSER_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
API_REQUESTS_PER_MINUTE=120
API_LOGINS_PER_MINUTE=10
API_REQUEST_BODY_MAX_BYTES=65536
API_REQUEST_BODY_TIMEOUT_SECONDS=10

# Legacy local deployment/read adapter only; current API uses API_BLOCKCHAIN_* above.
CHAIN_CONFIRMATIONS=1
CHAIN_DEPLOYER_PRIVATE_KEY=
CHAIN_MOCK_ISSUER_ADDRESS=
CHAIN_MOCK_SIGNER_ADDRESS=
CHAIN_ISSUER_REGISTRY_ADDRESS=
CHAIN_ISSUER_KEY_REGISTRY_ADDRESS=
# v3 independent runtime: inject the real Registry/analyzer in create_app; see docs/api/v5_c_runtime.md.
# API_WALLET_REGISTRY_ADDRESS must come from the new deployment, not a Golden vector.
# Seed v5 roster accounts with `make v5-wallet-seed`; see docs/runbooks/v5_wallet_local.md.
API_WALLET_OPERATOR_ADDRESSES={}
API_WALLET_INTERNAL_APPROVERS={}
API_WALLET_DEMO_EMAIL_ENABLED=false
API_WALLET_TEXT_INPUT_ENABLED=false
API_WALLET_RELAY_ENABLED=false
