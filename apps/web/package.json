{
  "name": "originproof-demo-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run build:official && next dev",
    "build": "npm run build:official && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run prepare:official && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:official": "npm run prepare:official && npm --prefix official run build",
    "prepare:official": "npm --prefix official ci --ignore-scripts"
  },
  "dependencies": {
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.3",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
