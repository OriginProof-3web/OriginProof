{
  "$defs": {
    "CardPaymentNoticeCandidate": {
      "additionalProperties": false,
      "description": "Candidate fields extracted from user input; this model has no authenticity result.",
      "properties": {
        "amount_minor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Minor"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "issuer_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer Name"
        },
        "masked_card": {
          "anyOf": [
            {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Card"
        },
        "merchant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "proof_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Id"
        },
        "transaction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction Id"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "CardPaymentNoticeCandidate",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted candidate fields plus an identifier for the server-side signed proof.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CardPaymentNoticeCandidate"
    },
    "proof_id": {
      "pattern": "^prf_[A-Za-z0-9_-]+$",
      "title": "Proof Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^req_[A-Za-z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "proof_id",
    "candidate",
    "request_id"
  ],
  "title": "VerificationRequest",
  "type": "object"
}
