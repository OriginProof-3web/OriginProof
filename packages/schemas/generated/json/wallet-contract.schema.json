{
  "$defs": {
    "AnalysisEvidence": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "RULE",
            "LLM"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        }
      },
      "required": [
        "rule_id",
        "quote",
        "source"
      ],
      "title": "AnalysisEvidence",
      "type": "object"
    },
    "AnalysisJob": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "pattern": "^ana_[A-Za-z0-9_-]+$",
          "title": "Analysis Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "original_expires_at": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Expires At"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result_expires_at": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Expires At"
        },
        "retain_original": {
          "title": "Retain Original",
          "type": "boolean"
        },
        "retain_report": {
          "title": "Retain Report",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "EXPIRED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "analysis_id",
        "status",
        "retain_report",
        "retain_original"
      ],
      "title": "AnalysisJob",
      "type": "object"
    },
    "AnalysisList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AnalysisJob"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "AnalysisList",
      "type": "object"
    },
    "AnalysisReport": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/AnalysisEvidence"
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "risk_level": {
          "enum": [
            "HIGH",
            "CAUTION",
            "NO_CLEAR_INDICATORS",
            "UNDETERMINED"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_not_run_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Not Run Reason"
        }
      },
      "required": [
        "risk_level",
        "evidence",
        "limitations"
      ],
      "title": "AnalysisReport",
      "type": "object"
    },
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "input_ref": {
          "title": "Input Ref",
          "type": "string"
        },
        "request_id": {
          "pattern": "^req_[A-Za-z0-9_-]{1,124}$",
          "title": "Request Id",
          "type": "string"
        },
        "retain_original": {
          "default": false,
          "title": "Retain Original",
          "type": "boolean"
        },
        "retain_report": {
          "default": false,
          "title": "Retain Report",
          "type": "boolean"
        },
        "verification_session_id": {
          "anyOf": [
            {
              "pattern": "^vsn_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Session Id"
        }
      },
      "required": [
        "request_id",
        "input_ref"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "status": {
          "enum": [
            "PASSED",
            "FAILED",
            "NOT_RUN",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "DemoEmailCode": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[0-9]{6}$",
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "DemoEmailCode",
      "type": "object"
    },
    "DemoEmailRequest": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "DemoEmailRequest",
      "type": "object"
    },
    "DemoInbox": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "demo_only": {
          "const": true,
          "default": true,
          "title": "Demo Only",
          "type": "boolean"
        },
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "expires_at"
      ],
      "title": "DemoInbox",
      "type": "object"
    },
    "DirectTransaction": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^req_[A-Za-z0-9_-]{1,124}$",
          "title": "Request Id",
          "type": "string"
        },
        "signing_request_id": {
          "pattern": "^wsr_[A-Za-z0-9_-]+$",
          "title": "Signing Request Id",
          "type": "string"
        },
        "tx_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Tx Hash",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "signing_request_id",
        "tx_hash"
      ],
      "title": "DirectTransaction",
      "type": "object"
    },
    "DocumentDraftRequest": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "discriminator": {
            "mapping": {
              "OFFICIAL_DOCUMENT": "#/$defs/OfficialContent",
              "PAYMENT_REQUEST": "#/$defs/PaymentContent"
            },
            "propertyName": "notice_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PaymentContent"
            },
            {
              "$ref": "#/$defs/OfficialContent"
            }
          ],
          "title": "Content"
        },
        "doc_key": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Doc Key",
          "type": "string"
        },
        "expected_version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^req_[A-Za-z0-9_-]{1,124}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "doc_key",
        "expected_version",
        "expires_at",
        "content"
      ],
      "title": "DocumentDraftRequest",
      "type": "object"
    },
    "DocumentImageInputRequest": {
      "additionalProperties": false,
      "description": "One-page document photo (#92). The server checks MIME, signature, size and pixels.",
      "properties": {
        "image_base64": {
          "maxLength": 7340032,
          "minLength": 1,
          "title": "Image Base64",
          "type": "string"
        },
        "image_media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Image Media Type",
          "type": "string"
        },
        "kind": {
          "const": "DOCUMENT_IMAGE",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "image_media_type",
        "image_base64"
      ],
      "title": "DocumentImageInputRequest",
      "type": "object"
    },
    "DocumentView": {
      "additionalProperties": false,
      "properties": {
        "content_schema": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Content Schema",
          "type": "string"
        },
        "doc_key": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Doc Key",
          "type": "string"
        },
        "document_id": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Document Id",
          "type": "string"
        },
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "issued_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Issued At",
          "type": "integer"
        },
        "issuer_id": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Issuer Id",
          "type": "string"
        },
        "key_id": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "latest_version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Latest Version",
          "type": "integer"
        },
        "original_available": {
          "title": "Original Available",
          "type": "boolean"
        },
        "original_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Original Hash",
          "type": "string"
        },
        "protected_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Protected Hash",
          "type": "string"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "SUPERSEDED",
            "EXPIRED"
          ],
          "title": "State",
          "type": "string"
        },
        "version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "enum": [
              "ISSUER_SUSPENDED",
              "KEY_COMPROMISED",
              "CHAIN_UNAVAILABLE"
            ],
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "issuer_id",
        "doc_key",
        "key_id",
        "version",
        "latest_version",
        "state",
        "warnings",
        "original_hash",
        "protected_hash",
        "content_schema",
        "issued_at",
        "expires_at",
        "original_available"
      ],
      "title": "DocumentView",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "field_paths": {
          "items": {
            "type": "string"
          },
          "title": "Field Paths",
          "type": "array"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[A-Za-z0-9_-]{1,124}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": [
        "detail"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "GovernanceProposal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Action",
          "type": "integer"
        },
        "deadline": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Deadline",
          "type": "integer"
        },
        "issuerId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Issuerid",
          "type": "string"
        },
        "keyId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Keyid",
          "type": "string"
        },
        "metadataHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Metadatahash",
          "type": "string"
        },
        "nonce": {
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Nonce",
          "type": "string"
        },
        "signer": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Signer",
          "type": "string"
        }
      },
      "required": [
        "action",
        "issuerId",
        "keyId",
        "signer",
        "metadataHash",
        "nonce",
        "deadline"
      ],
      "title": "GovernanceProposal",
      "type": "object"
    },
    "GovernanceTransaction": {
      "additionalProperties": false,
