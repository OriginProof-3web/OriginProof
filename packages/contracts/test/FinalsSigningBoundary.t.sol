pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";

contract FinalsSigningBoundaryTest is Test {
    function testPaymentRequestCanonicalDigestMatchesPythonVector() public pure {
        bytes memory canonical =
            hex"";
        assertEq(
            keccak256(canonical), 0xd1e7070cb88ad466e989f57b5de6b960277d9d05229398487bf8b4e89aa9a605
        );
    }

    function testOfficialDocumentCanonicalDigestMatchesPythonVector() public pure {
        bytes memory canonical =
            hex"";
        assertEq(
            keccak256(canonical), 0x370794f760bddd7d2684d65f23f05b68bc1b9d2d0726a33092c47f3949e0a895
        );
    }
}
